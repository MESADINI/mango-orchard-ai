# Copy to backend/.env and adjust. Every value is optional for local development.

# REQUIRED for anything beyond local testing: a long random secret used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Demo account created on first start when the database is empty (leave email empty to disable).
DEMO_USER_EMAIL=grower@mango.ai
DEMO_USER_PASSWORD=orchard123

# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum upload size per image, and pest detector confidence threshold.
MAX_UPLOAD_MB=15
PEST_CONFIDENCE_THRESHOLD=0.25

# Weather API (no key required).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Optional Supabase Auth. Leave the placeholders to use the built-in SQLite accounts only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Optional path overrides (use absolute paths). Defaults:
#   DATABASE_PATH        = <repo>/backend/data/mango_orchard.db
#   MEDIA_DIR            = <repo>/backend/media
#   DISEASE_WEIGHTS_PATH = <repo>/ml/disease_detection/weights/disease_classifier.pth
#   PEST_WEIGHTS_PATH    = <repo>/ml/pest_detection/weights/pest_detector.pt
